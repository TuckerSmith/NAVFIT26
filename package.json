{
  "name": "navfit26-master",
  "version": "1.0.0",
  "description": "NAVFIT26 Master Launcher",
  "main": "electron2.1/main.js",
  "author": {
    "name": "Tucker Smith",
    "email": "tucker.smith@example.com"
  },
  "license": "ISC",
  "scripts": {
    "install-all": "npm install && npm install --prefix frontend2.1 && npm install --prefix backend2.1 && npm install --prefix electron2.1",
    "build-ui": "npm run build --prefix frontend2.1",
    "start": "npm run build-ui && cd electron2.1 && npm start",
    "clean": "node -e \"['frontend2.1/dist', 'electron2.1/frontend_build', 'frontend2.1/node_modules', 'backend2.1/node_modules', 'electron2.1/node_modules'].forEach(p => { if(fs.existsSync(p)) fs.rmSync(p, {recursive:true}) })\"",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.navfit26.master",
    "productName": "NAVFIT26",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "electron2.1/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "package.json",
      "electron2.1/**/*",
      "backend2.1/**/*",
      "electron2.1/node_modules/**/*",
      "node_modules/**/*",
      {
        "from": "frontend2.1/dist",
        "to": "electron2.1/frontend_build",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Tucker Smith <tucker.smith@example.com>",
      "category": "Office"
    }
  }
}